          "value": 1.0
        },
        {
          "field": "scene.render.use_simplify",
          "label": "Use Simplify",
          "description": "Enable simplification of scene for quicker preview renders",
          "type": "BOOLEAN",
          "value": false
        },
        {
          "field": "scene.render.simplify_subdivision",
          "label": "Simplify Subdivision",
          "description": "Global maximum subdivision level",
          "type": "INT",
          "value": 6
        },
        {
          "field": "scene.render.simplify_child_particles",
          "label": "Simplify Child Particles",
          "description": "Global child particles percentage",
          "type": "FLOAT",
          "value": 1.0
        }
      ]
    },
    "color_management": {
      "category_label": "Color Management",
      "category_id": "color_management",
      "properties": [
